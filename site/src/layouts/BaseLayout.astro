---
import "../styles/global.css";
import "katex/dist/katex.min.css";
import { withBase } from "../lib/url";

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string | false;
  pageClass?: string;
}

const {
  title,
  description = "Cahier — 文献笔记与教学讲稿档案",
  canonicalPath = "/",
  pageClass = "",
} = Astro.props;

const siteName = "Cahier";
const documentTitle = title ? `${title}｜${siteName}` : siteName;
const canonicalUrl = canonicalPath !== false && Astro.site
  ? new URL(withBase(canonicalPath), Astro.site)
  : undefined;
---

<!doctype html>
<html lang="zh-CN" data-theme="cobalt">
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" type="image/svg+xml" href={withBase("favicon.svg") + "?v=cahier3"} />
    <link rel="icon" href={withBase("favicon.ico") + "?v=cahier3"} sizes="any" />
    <link rel="icon" type="image/png" sizes="180x180" href={withBase("favicon.png") + "?v=cahier3"} />
    <link rel="apple-touch-icon" href={withBase("favicon.png") + "?v=cahier3"} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#eef4ff" id="metaThemeColor" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    <title>{documentTitle}</title>
    {/* 渲染前应用已保存的主题，避免暗夜模式刷新时白屏闪烁 */}
    <script is:inline>
      (() => {
        try {
          const saved = localStorage.getItem("cahier-theme");
          const t = saved === "night" ? "night" : "cobalt";
          document.documentElement.setAttribute("data-theme", t);
        } catch { /* localStorage 不可用时保持白昼 */ }
      })();
    </script>
    {/* 渲染前应用已保存的笔记显隐状态，避免笔记纸刷新时闪现 */}
    <script is:inline>
      (() => {
        try {
          if (localStorage.getItem("cahier-notes") === "open") {
            document.documentElement.classList.add("is-notes-open");
          }
        } catch { /* 忽略 */ }
      })();
    </script>
  </head>
  <body class={pageClass}>
    <a class="skip-link" href="#main-content">跳到正文</a>

    <header class="site-header" id="siteHeader">
      <div class="shell site-header__inner">
        <div class="site-header__left">
          <a class="site-brand" href={withBase("/")} aria-label="Cahier 首页">
            <span class="site-brand__copy">
              <span class="site-brand__name">Cahier</span>
            </span>
          </a>
        </div>

        <div class="site-header__center">
          <slot name="header-center" />
        </div>

        <div class="site-header__right">
          <!-- 笔记显隐切换（默认隐藏笔记：铅笔带斜杠；开启后两纸左右摊开） -->
          <button
            type="button"
            class="notes-toggle"
            id="notesToggle"
            aria-label="显示笔记纸"
            title="显示 / 隐藏笔记纸"
            aria-pressed="false"
          >
            <svg class="notes-toggle__pencil" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/>
              <path d="m15 5 4 4"/>
            </svg>
            <svg class="notes-toggle__slash" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
              <path d="m4 4 16 16"/>
            </svg>
          </button>

          <!-- 暗夜 / 白昼主题切换（纯图标，圆形破口转场） -->
          <button
            type="button"
            class="theme-toggle"
            id="themeToggle"
            aria-label="切换到暗夜模式"
            title="切换暗夜 / 白昼"
            aria-pressed="false"
          >
            <svg class="theme-toggle__icon theme-toggle__icon--moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/>
            </svg>
            <svg class="theme-toggle__icon theme-toggle__icon--sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="4"/>
              <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/>
            </svg>
          </button>

          <div class="site-clock" id="siteClock" aria-label="当前时间">
            <span class="site-clock__dot" aria-hidden="true"></span>
            <span class="site-clock__time" id="clockTime">--:--:--</span>
          </div>
        </div>
      </div>
    </header>

    <main id="main-content">
      <slot />
    </main>

    <footer class="site-footer">
      <!-- 站底三层视差水彩横带（成品手绘水彩风）：远(蓝天白云飞鸟·最慢)/中(绿丘大树木屋)/近(花草蘑菇·最快)，
           每层两张相同无缝横带，轨道右往左匀速平移一个周期，首尾真正无缝；夜间自动压暗，落叶随风飘过。 -->
      <div class="foot-scene" aria-hidden="true">
        <div class="foot-layer foot-layer--far">
          <img class="foot-art" src={withBase("footer/far.webp")} alt="" loading="lazy" decoding="async" width="1960" height="480" />
          <img class="foot-art" src={withBase("footer/far.webp")} alt="" loading="lazy" decoding="async" width="1960" height="480" />
        </div>
        <div class="foot-layer foot-layer--mid">
          <img class="foot-art" src={withBase("footer/mid.webp")} alt="" loading="lazy" decoding="async" width="1960" height="576" />
          <img class="foot-art" src={withBase("footer/mid.webp")} alt="" loading="lazy" decoding="async" width="1960" height="576" />
        </div>
        <div class="foot-layer foot-layer--near">
          <img class="foot-art" src={withBase("footer/near.webp")} alt="" loading="lazy" decoding="async" width="1960" height="576" />
          <img class="foot-art" src={withBase("footer/near.webp")} alt="" loading="lazy" decoding="async" width="1960" height="576" />
        </div>
        <div class="foot-leaves">
          <i class="foot-leaf foot-leaf--a"></i>
          <i class="foot-leaf foot-leaf--b"></i>
          <i class="foot-leaf foot-leaf--c"></i>
        </div>
      </div>
    </footer>

    <!-- 主题切换圆形破口揭示层（Aperture Reveal） -->
    <div class="theme-veil" id="themeVeil" aria-hidden="true"></div>

    <script>
      // Beijing time clock
      function updateClock() {
        const now = new Date();
        const parts = new Intl.DateTimeFormat("en-GB", {
          timeZone: "Asia/Shanghai",
          hour: "2-digit",
          minute: "2-digit",
          second: "2-digit",
          hour12: false,
        }).formatToParts(now);
        const get = (t: string) => parts.find((p) => p.type === t)?.value ?? "00";
        const el = document.getElementById("clockTime");
        if (el) el.textContent = `${get("hour")}:${get("minute")}:${get("second")}`;
      }
      updateClock();
      setInterval(updateClock, 1000);

      // Scroll fade: hide when scrolling down, show when scrolling up
      const header = document.getElementById("siteHeader");
      let lastScroll = 0;
      let ticking = false;

      function onScroll() {
        const currentScroll = window.scrollY;
        if (currentScroll > 100 && currentScroll > lastScroll) {
          header?.classList.add("is-hidden");
        } else {
          header?.classList.remove("is-hidden");
        }
        lastScroll = currentScroll;
        ticking = false;
      }

      window.addEventListener(
        "scroll",
        () => {
          if (!ticking) {
            requestAnimationFrame(onScroll);
            ticking = true;
          }
        },
        { passive: true },
      );

      /* ════════ 暗夜 / 白昼：圆形破口主题切换（View Transitions + 降级） ════════ */
      const root = document.documentElement;
      const toggleBtn = document.getElementById("themeToggle") as HTMLButtonElement | null;
      const veil = document.getElementById("themeVeil") as HTMLElement | null;
      const metaColor = document.getElementById("metaThemeColor") as HTMLMetaElement | null;

      const THEME_CHROME: Record<string, string> = {
        cobalt: "#eef4ff",
        night: "#11151d",
      };
      const THEME_BG: Record<string, string> = {
        cobalt: "hsl(220, 100%, 98%)",
        night: "hsl(222, 32%, 9%)",
      };
      // 柔和流畅的缓动：先快后慢，自然舒展
      const REVEAL_EASE = "cubic-bezier(0.22, 1, 0.36, 1)";
      const REVEAL_DURATION = 650;
      let animating = false;

      function currentTheme(): string {
        return root.getAttribute("data-theme") === "night" ? "night" : "cobalt";
      }

      // 同步按钮外观 / aria / 地址栏 / 3D iframe
      function reflectTheme(theme: string) {
        const isNight = theme === "night";
        toggleBtn?.setAttribute("aria-pressed", isNight ? "true" : "false");
        toggleBtn?.setAttribute("aria-label", isNight ? "切换到白昼模式" : "切换到暗夜模式");
        if (metaColor) metaColor.setAttribute("content", THEME_CHROME[theme] ?? THEME_CHROME.cobalt);
        document.querySelectorAll("iframe").forEach((f) => {
          try { f.contentWindow?.postMessage({ type: "le-theme", theme }, "*"); } catch { /* 跨域忽略 */ }
        });
      }

      function applyTheme(theme: string) {
        root.setAttribute("data-theme", theme);
        try { localStorage.setItem("cahier-theme", theme); } catch { /* 忽略 */ }
        reflectTheme(theme);
      }

      // 获取切换按钮中心坐标（视口百分比，供 View Transitions 使用）
      function getRevealOrigin(): { xPct: string; yPct: string; cx: number; cy: number } {
        let cx = window.innerWidth - 20;
        let cy = 20;
        if (toggleBtn) {
          const r = toggleBtn.getBoundingClientRect();
          cx = r.left + r.width / 2;
          cy = r.top + r.height / 2;
        }
        return {
          xPct: `${(cx / window.innerWidth) * 100}%`,
          yPct: `${(cy / window.innerHeight) * 100}%`,
          cx,
          cy,
        };
      }

      // 降级方案：纯色 veil 圆形扩散（不支持 View Transitions 时使用）
      function toggleWithVeil(to: string) {
        if (!veil) { applyTheme(to); return; }
        const { cx, cy } = getRevealOrigin();
        const maxR = Math.hypot(
          Math.max(cx, window.innerWidth - cx),
          Math.max(cy, window.innerHeight - cy),
        ) + 24;

        veil.style.background = THEME_BG[to];
        veil.style.transition = "none";
        veil.style.clipPath = `circle(0px at ${cx}px ${cy}px)`;
        veil.style.display = "block";
        veil.setAttribute("aria-hidden", "false");
        void veil.offsetWidth;
        veil.style.transition = `clip-path ${REVEAL_DURATION}ms ${REVEAL_EASE}`;
        veil.style.clipPath = `circle(${maxR}px at ${cx}px ${cy}px)`;

        window.setTimeout(() => applyTheme(to), REVEAL_DURATION * 0.5);
        window.setTimeout(() => {
          veil.style.display = "none";
          veil.style.clipPath = "circle(0px at 0 0)";
          veil.setAttribute("aria-hidden", "true");
          animating = false;
        }, REVEAL_DURATION + 40);
      }

      function toggleTheme() {
        if (animating) return;
        animating = true;
        const from = currentTheme();
        const to = from === "night" ? "cobalt" : "night";
        const { xPct, yPct } = getRevealOrigin();

        // 优先使用 View Transitions API：新主题页面从按钮处圆形扩大中真实呈现
        if (typeof document.startViewTransition === "function") {
          // 设置破口原点坐标（CSS 变量供 keyframes 使用）
          document.documentElement.style.setProperty("--reveal-x", xPct);
          document.documentElement.style.setProperty("--reveal-y", yPct);

          const transition = document.startViewTransition(() => {
            applyTheme(to);
          });

          transition.finished.then(() => {
            animating = false;
          }).catch(() => {
            animating = false;
          });
        } else {
          // 降级：纯色 veil 圆形扩散
          toggleWithVeil(to);
        }
      }

      toggleBtn?.addEventListener("click", toggleTheme);
      // 初始化按钮/地址栏/iframe 为当前主题
      reflectTheme(currentTheme());
      // iframe（如 3D 场景）加载后补发一次当前主题
      window.addEventListener("load", () => reflectTheme(currentTheme()));

      /* ════════ 笔记纸显隐：原文纸左移、笔记纸自其右后方摊开 ════════ */
      const notesBtn = document.getElementById("notesToggle") as HTMLButtonElement | null;
      function reflectNotes(open: boolean) {
        root.classList.toggle("is-notes-open", open);
        notesBtn?.setAttribute("aria-pressed", open ? "true" : "false");
        notesBtn?.setAttribute("aria-label", open ? "隐藏笔记纸" : "显示笔记纸");
      }
      reflectNotes(root.classList.contains("is-notes-open"));
      notesBtn?.addEventListener("click", () => {
        const open = !root.classList.contains("is-notes-open");
        try { localStorage.setItem("cahier-notes", open ? "open" : "closed"); } catch { /* 忽略 */ }
        reflectNotes(open);
      });

      /* ════════ 本地笔记编辑：仅 127.0.0.1 / localhost 启用，云端只读 ════════
       * 「所写即所得」的四条保证：
       * 1) 编辑区是纯文本面（只允许文本节点）：回车插入换行符、粘贴/拖放只取纯文本，
       *    外部网页的字体、颜色、段落样式一律进不来，全部继承笔记纸规定的字体；
       * 2) 每页可写行数由纸张物理高度固定：beforeinput 在 DOM 改变前预判，
       *    写满最后一行后再敲字符/回车一律直接拒绝（preventDefault），
       *    不做事后回滚、不跳动光标——最后一行按回车，什么都不会发生；
       * 3) 保存/恢复逐字使用 textContent：换行、空行、前导空格一个不丢，
       *    关闭服务、重新启动后仍是上次的样子；
       * 4) 构建期数据（folio-notes.json，云端笔记）为底稿，本地 localStorage 覆盖。
       * 中文输入法组词期间不干预，compositionend 统一收口。 */
      function setupEditableNotes() {
        const host = location.hostname;
        const isLocal = host === "localhost" || host === "127.0.0.1" || host === "[::1]";
        const edits = document.querySelectorAll<HTMLElement>(".folio__edit");
        if (!edits.length) return;
        if (!isLocal) {
          // 云端：只读、不显示编辑框外观
          document.body.classList.add("notes-cloud-readonly");
          return;
        }
        document.body.classList.add("notes-local-edit");
        /* 缓存键带「页数版本」：分页参数/排版改动会使页数变化，页码键随之错位；
         * 键里编入页数后，旧版缓存自动失效（不再用旧页码覆盖新分页的落盘笔记），
         * 用户在新页上的编辑写入新键。2026-10-29 分页修复（151→149 页）后必需。 */
        const keyBase = "cahier-note:" + location.pathname + ":v" + edits.length;

        // 导出当前文档全部页文本（快照 JSON）
        const gatherPages = () => {
          const pages: Record<string, string> = {};
          edits.forEach((el) => {
            pages[el.getAttribute("data-page") || "1"] = el.textContent || "";
          });
          return pages;
        };

        /* ── 本地自动回写：编辑即写回 git 跟踪的 folio-notes.json，无需手动导出 ──
         * 浏览器把当前书全部页防抖 POST 给本地编辑服务（/__cahier_notes），
         * 由它原子写入 site/src/data/folio-notes.json。刷新/重启由 localStorage 兜底，
         * 上线时重新 build 即把这些笔记烤进静态站推上云端。 */
        const sourceKey = document.querySelector("[data-cahier-source]")?.getAttribute("data-cahier-source") || "";
        let serverTimer: ReturnType<typeof setTimeout> | null = null;
        const flushServerSave = () => {
          if (!sourceKey) return;
          const payload = { source: sourceKey, pathname: location.pathname, pages: gatherPages() };
          try {
            fetch("/__cahier_notes", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify(payload),
              keepalive: true,
            });
          } catch { /* 离线时静默，localStorage 仍在 */ }
        };
        const scheduleServerSave = () => {
          if (serverTimer) clearTimeout(serverTimer);
          serverTimer = setTimeout(flushServerSave, 800);
        };
        window.addEventListener("beforeunload", flushServerSave);

        edits.forEach((el) => {
          const page = el.getAttribute("data-page") || "1";
          const key = keyBase + ":" + page;
          // 构建期数据为底稿；本地有保存则覆盖（注意 null 与 "" 的区别）
          let saved: string | null = null;
          try { saved = localStorage.getItem(key); } catch {}
          if (saved !== null) el.textContent = saved;
          el.setAttribute("contenteditable", "true");

          /* ── 隐藏标尺：编辑区的“孪生”测量面。
           * 宽度必须用 clientWidth（zoom:1.2 上下文中的布局像素），绝不能用
           * getBoundingClientRect().width——后者把 zoom 视觉缩放也算进去，
           * 得到约 1.2 倍偏宽，标尺折行更少、误判“放得下”，是旧版顶格错乱的根因。
           * 标尺与编辑区同字体、同折行宽度，scrollHeight 即真实内容高。 ── */
          const gauge = el.cloneNode(false) as HTMLElement;
          gauge.removeAttribute("contenteditable");
          gauge.removeAttribute("data-page");
          gauge.removeAttribute("aria-label");
          gauge.style.cssText =
            "position:absolute;left:-99999px;top:0;visibility:hidden;pointer-events:none;" +
            "height:auto;min-height:0;max-height:none;flex:none;overflow:hidden;margin:0;padding:0;";
          const syncGaugeWidth = () => { gauge.style.width = el.clientWidth + "px"; };
          syncGaugeWidth();
          el.parentNode!.appendChild(gauge);
          // 视口变化（--spread-scale 分档）后重新对齐一次测量宽
          window.addEventListener("resize", syncGaugeWidth);

          /* 纸张容量：编辑区内容盒高（布局像素）。内容高 ≤ 此值即放得下。 */
          const capacity = () => el.clientHeight;
          const fits = (text: string) => {
            gauge.textContent = text;
            return gauge.scrollHeight <= capacity() + 1;
          };

          let composing = false;
          let beforeComposition: string | null = null;

          /* 光标字符偏移（DOM 内只有文本节点，Range.toString 即字符数） */
          const caretOffsets = (): [number, number] | null => {
            const sel = window.getSelection();
            if (!sel || !sel.rangeCount) return null;
            const range = sel.getRangeAt(0);
            if (!el.contains(range.startContainer)) return null;
            const r = range.cloneRange();
            r.selectNodeContents(el);
            r.setEnd(range.startContainer, range.startOffset);
            const start = r.toString().length;
            const r2 = range.cloneRange();
            r2.selectNodeContents(el);
            r2.setEnd(range.endContainer, range.endOffset);
            return [start, r2.toString().length];
          };
          const prospective = (insert: string) => {
            const cur = el.textContent || "";
            const offs = caretOffsets();
            if (!offs) return cur + insert;
            return cur.slice(0, offs[0]) + insert + cur.slice(offs[1]);
          };
          const save = () => {
            try { localStorage.setItem(key, el.textContent || ""); } catch {}
            scheduleServerSave();
          };

          /* 纯文本插入：只建文本节点，样式继承笔记纸（外部格式无从进入） */
          const insertPlain = (text: string) => {
            if (!text) return;
            el.focus();
            const sel = window.getSelection();
            let range: Range;
            if (sel && sel.rangeCount && el.contains(sel.getRangeAt(0).commonAncestorContainer)) {
              range = sel.getRangeAt(0);
            } else {
              range = document.createRange();
              range.selectNodeContents(el);
              range.collapse(false);
            }
            range.deleteContents();
            const node = document.createTextNode(text);
            range.insertNode(node);
            range.setStartAfter(node);
            range.collapse(true);
            sel!.removeAllRanges();
            sel!.addRange(range);
            save(); // 手动 DOM 改动不触发 input，显式保存
          };

          /* 粘贴/拖放文本规整：换行统一为 \n、去 BOM、NBSP 转普通空格 */
          const normalizePlain = (raw: string) =>
            raw.replace(/\r\n?/g, "\n").replace(/\uFEFF/g, "").replace(/\u00A0/g, " ");

          /* HTML 转纯文本：用临时 DOM 解析（不插入文档、不执行脚本），
           * 块级元素之间补换行，<br> 转换行，再取 textContent，丢弃一切样式属性。 */
          const htmlToPlainText = (html: string) => {
            if (!html) return "";
            const tpl = document.createElement("template");
            tpl.innerHTML = html;
            const frag = tpl.content;
            const walk = (node: Node): string => {
              if (node.nodeType === 3) return node.nodeValue || ""; // 文本节点
              if (node.nodeType !== 1) return "";                   // 注释等忽略
              const el = node as HTMLElement;
              const tag = el.tagName;
              if (tag === "BR") return "\n";
              if (tag === "SCRIPT" || tag === "STYLE") return "";    // 内容不进笔记
              let inner = "";
              el.childNodes.forEach((c) => { inner += walk(c); });
              if (/^(P|DIV|LI|TR|H[1-6]|BLOCKQUOTE|PRE|SECTION|ARTICLE)$/.test(tag)) {
                return "\n" + inner + "\n";
              }
              return inner;
            };
            let out = "";
            frag.childNodes.forEach((c) => { out += walk(c); });
            // 折叠多余换行、去首尾空白后交给 normalizePlain 统一
            return normalizePlain(out.replace(/\n{3,}/g, "\n\n").replace(/^\n+|\n+$/g, ""));
          };

          /* 插入并遵守纸张容量：写不下时只放能容纳的最长前缀（物理纸写满即止） */
          const insertPlainWithFit = (raw: string) => {
            const text = normalizePlain(raw);
            if (!text) return;
            if (fits(prospective(text))) { insertPlain(text); return; }
            const cur = el.textContent || "";
            const offs = caretOffsets();
            const [s, e] = offs || [cur.length, cur.length];
            const head = cur.slice(0, s);
            const tail = cur.slice(e);
            const maxLen = (n: number) => fits(head + text.slice(0, n) + tail);
            if (!maxLen(0)) return; // 纸已满，一字放不下
            let lo = 0;
            let hi = text.length;
            while (lo < hi) {
              const mid = (lo + hi + 1) >> 1;
              if (maxLen(mid)) lo = mid; else hi = mid - 1;
            }
            // 不切开 UTF-16 代理对
            if (lo > 0) {
              const c = text.charCodeAt(lo - 1);
              if (c >= 0xD800 && c <= 0xDBFF) lo -= 1;
            }
            if (lo > 0) insertPlain(text.slice(0, lo));
          };

          /* 回车：插入换行符；最后一行按回车，什么都不发生（纸已写满） */
          el.addEventListener("keydown", (ev) => {
            if (ev.key === "Enter" && !composing) {
              ev.preventDefault();
              if (fits(prospective("\n"))) insertPlain("\n");
            }
          });

          /* beforeinput：DOM 改变前拦截，写不下即拒绝——从源头杜绝事后回滚顶格 */
          el.addEventListener("beforeinput", (ev) => {
            const ie = ev as InputEvent;
            const type = ie.inputType || "";
            if (composing) return;
            if (type === "insertParagraph" || type === "insertLineBreak") {
              ev.preventDefault(); // 物理键盘回车已由 keydown 处理；软键盘在此兜底
              if (fits(prospective("\n"))) insertPlain("\n");
              return;
            }
            if (type === "insertFromPaste" || type === "insertFromPasteAsQuotation") {
              ev.preventDefault();
              const dt = ie.dataTransfer;
              insertPlainWithFit((dt && dt.getData("text/plain")) || ie.data || "");
              return;
            }
            if (type === "insertFromDrop") {
              ev.preventDefault();
              insertPlainWithFit((ie.dataTransfer && ie.dataTransfer.getData("text/plain")) || ie.data || "");
              return;
            }
            if (type === "insertReplacementText") {
              ev.preventDefault();
              insertPlainWithFit(ie.data || "");
              return;
            }
            if (type === "insertHTML") {
              // 输入法整句上屏、自动更正、部分拖拽会带 HTML：剥掉标签只留纯文本，
              // 外部字体/颜色/粗体一律进不来，且不会把 <br>/<div> 塞进纯文本模型。
              ev.preventDefault();
              insertPlainWithFit(htmlToPlainText(ie.data || ""));
              return;
            }
            if (type.indexOf("insert") === 0) {
              // insertText / insertDictate 等：纯文本
              const data = ie.data || "";
              if (!data) return;
              /* 含换行的插入（整段多行键入、语音听写、部分输入法整句上屏）：
               * 浏览器默认会把 \n 渲染成 <br>/<div>，而 textContent 读不到这些
               * 元素里的换行——保存/刷新后换行丢失、整段顶格挤成一坨（用户报的核心 Bug）。
               * 改为 preventDefault 后走 insertPlainWithFit 显式建纯文本节点，逐字保留 \n。 */
              if (/[\r\n]/.test(data)) {
                ev.preventDefault();
                insertPlainWithFit(data);
                return;
              }
              // 普通单行字符：写不下即拒绝，写得出就放行（浏览器建文本节点，安全）
              if (!fits(prospective(data))) ev.preventDefault();
            }
          });

          /* 粘贴事件双保险（部分浏览器不走 beforeinput）：只取纯文本，外部样式一律丢弃 */
          let pasteGuard = false;
          el.addEventListener("paste", (ev) => {
            ev.preventDefault();
            if (pasteGuard) return;
            pasteGuard = true;
            setTimeout(() => { pasteGuard = false; }, 0);
            const cd = (ev as ClipboardEvent).clipboardData;
            insertPlainWithFit((cd && cd.getData("text/plain")) || "");
          });
          /* 拖放双保险：只放纯文本 */
          el.addEventListener("dragover", (ev) => ev.preventDefault());
          el.addEventListener("drop", (ev) => {
            ev.preventDefault();
            const dt = (ev as DragEvent).dataTransfer;
            insertPlainWithFit((dt && dt.getData("text/plain")) || "");
          });

          /* 中文输入法：组词期间不干预，上屏后收口。
           * 整句上屏后若超出纸面，仅退回本次组词（回到组词前的已存状态），
           * 绝不连坐擦掉用户此前已写好的整页笔记。 */
          el.addEventListener("compositionstart", () => {
            composing = true;
            beforeComposition = el.textContent || "";
          });
          el.addEventListener("compositionend", () => {
            composing = false;
            if (beforeComposition !== null && !fits(el.textContent || "")) {
              el.textContent = beforeComposition;
            }
            save();
          });

          /* input：仅保存，绝不回滚已写文本。
           * 容量拦截已前置在 beforeinput；undo/redo 等漏网溢出由 CSS overflow:hidden
           * 在视觉上裁掉，不动用户文本，从根上消除“整页顶格错乱”。 */
          el.addEventListener("input", () => {
            if (composing) return;
            save();
          });
        });

        /* ── 手动“保存”：立即把笔记回写本地文件并弹提示（不再下载 JSON） ── */
        const flashSaved = () => {
          let tip = document.getElementById("notesSavedTip");
          if (!tip) {
            tip = document.createElement("div");
            tip.id = "notesSavedTip";
            tip.style.cssText =
              "position:fixed;right:24px;bottom:24px;z-index:9999;background:#1f2937;color:#fff;" +
              "padding:8px 14px;border-radius:8px;font-size:13px;opacity:0;transition:opacity .25s;pointer-events:none;";
            document.body.appendChild(tip);
          }
          tip.textContent = "笔记已保存到本地";
          tip.style.opacity = "1";
          const tipEl = tip as HTMLElement & { _t?: ReturnType<typeof setTimeout> };
          clearTimeout(tipEl._t);
          tipEl._t = setTimeout(() => { tip!.style.opacity = "0"; }, 1200);
        };
        const flushNow = () => {
          if (serverTimer) clearTimeout(serverTimer);
          flushServerSave();
          flashSaved();
        };
        document.addEventListener("keydown", (ev) => {
          if ((ev.ctrlKey || ev.metaKey) && ev.key.toLowerCase() === "s") {
            ev.preventDefault();
            flushNow();
          }
        });
      }
      window.addEventListener("DOMContentLoaded", setupEditableNotes);
    </script>
  </body>
</html>
