---
import { render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Cover from "../../components/Cover.astro";
import { getCatalog, getNoteById } from "../../lib/catalog";
import {
  collectionUrl,
  encodePath,
  withBase,
} from "../../lib/url";

export async function getStaticPaths() {
  const catalog = await getCatalog();

  return catalog.notes
    .filter((note) => !note.draft)
    .map((note) => ({ params: { id: note.id } }));
}

const id = Astro.params.id ?? "";
const note = await getNoteById(id);

if (!note || note.draft) {
  throw new Error(`Note not found: ${id}`);
}

const { Content, headings } = await render(note.entry);
// 页内导航：优先取「第 N 页」锚点，否则取二级/三级标题
const pageAnchors = headings
  .filter((h) => h.depth === 2)
  .slice(0, 40);
const repositoryUrl = `https://github.com/NewtNorlly/Cahier/blob/main/${encodePath(note.sourcePath)}`;
const isLiterature = note.collectionName === "文献笔记";
const kindLabel = isLiterature ? "文献笔记" : "教学讲稿";
const sourceLabel = isLiterature ? "查看原始文献" : "查看原始讲稿";

const homeTarget = isLiterature ? "literature" : "lectures";
const parentUrl = isLiterature ? undefined : collectionUrl(note.collectionId);
const isFolioDoc = true; // 新版统一为三栏文档体
const eyebrow = isLiterature ? "文献笔记" : `教学讲稿 · ${note.collectionName}`;
---

<BaseLayout
  title={note.title}
  description={note.description || `${note.collectionName}收录的${kindLabel}。`}
  canonicalPath={`/notes/${encodeURIComponent(note.id)}/`}
  pageClass="article-page doc-page"
>
  <div class="article-shell">
    <nav class="article-back" aria-label="返回导航">
      <a class="article-back__btn" href={`${withBase("/") + "#" + homeTarget}`}>返回首页</a>
      {parentUrl && <a class="article-back__btn" href={parentUrl}>返回课程</a>}
    </nav>
  </div>

  <!-- 封面 Hero：左为生成的封面图，右为题录 -->
  <header class="cover-hero">
    <div class="article-shell cover-hero__grid">
      <div class="cover-hero__art">
        <Cover
          cover={note.cover}
          title={note.title}
          eager
          class="cover-hero__img"
        />
      </div>
      <div class="cover-hero__meta">
        <p class="eyebrow">{eyebrow}</p>
        <h1>{note.title}</h1>
        {note.author && <p class="cover-hero__author">{note.author}</p>}
        {note.description && (
          <p class="cover-hero__desc">{note.description}</p>
        )}
        <div class="article-header__links">
          {note.sourceUrl && (
            <a href={note.sourceUrl} target="_blank" rel="noreferrer">{sourceLabel}</a>
          )}
          <a href={repositoryUrl} target="_blank" rel="noreferrer">查看 Markdown 源文件</a>
        </div>
      </div>
    </div>
  </header>

  <!-- 页内快速导航（按 PDF 页） -->
  {pageAnchors.length > 1 && (
    <nav class="page-jump article-shell" aria-label="按页跳转">
      {pageAnchors.map((h) => (
        <a href={`#${h.slug}`}>{h.text.replace(/^第\s*/, "").replace(/\s*页$/, "")}</a>
      ))}
    </nav>
  )}

  <!-- 三栏文档体：左批注 / 中原文 / 右批注 -->
  <div class="doc-body">
    <article class:list={["doc-canvas", { "is-folio": isFolioDoc }]}>
      <Content />
    </article>
  </div>

  <div class="article-shell">
    <div class="article-end">
      <a class="article-back__btn" href={`${withBase("/") + "#" + homeTarget}`}>返回首页</a>
      {parentUrl && <a class="article-back__btn" href={parentUrl}>返回「{note.collectionName}」</a>}
    </div>
  </div>
</BaseLayout>

<style>
  .cover-hero {
    padding-block: clamp(2rem, 5vw, 4.2rem);
    border-bottom: 1px solid var(--line-soft);
  }

  .cover-hero__grid {
    display: grid;
    grid-template-columns: minmax(15rem, 21rem) minmax(0, 1fr);
    align-items: center;
    gap: clamp(2rem, 6vw, 5.5rem);
  }

  .cover-hero__art {
    perspective: 1400px;
  }

  .cover-hero__img {
    aspect-ratio: 3 / 4;
    border-radius: var(--radius-md);
    overflow: hidden;
    box-shadow:
      0 2px 6px hsl(var(--fg) / 0.05),
      0 18px 44px hsl(var(--fg) / 0.12);
    transform: rotateY(-7deg) rotateX(2deg);
    transition: transform 0.6s var(--ease-spring);
  }

  .cover-hero__img:hover {
    transform: rotateY(0deg) rotateX(0deg);
  }

  .cover-hero__meta h1 {
    margin-top: 0.9rem;
    font-size: var(--title-large);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.35;
    text-wrap: balance;
  }

  .cover-hero__author {
    margin-top: 1rem;
    font-size: 1.1rem;
    color: #B4552D;
    letter-spacing: 0.05em;
  }

  .cover-hero__desc {
    margin-top: 1.2rem;
    max-width: 42rem;
    color: var(--ink-soft);
    line-height: 1.9;
  }

  .eyebrow {
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    color: #B4552D;
  }

  .page-jump {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    padding-top: 1.4rem;
    padding-bottom: 0.2rem;
  }

  .page-jump a {
    min-width: 2.3rem;
    text-align: center;
    padding: 0.32rem 0.6rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: hsl(var(--card) / 0.7);
    font-family: var(--font-latin);
    font-size: 0.82rem;
    color: var(--ink-soft);
    text-decoration: none;
    transition: all var(--duration-quick) var(--ease-out);
  }

  .page-jump a:hover {
    border-color: var(--vermillion);
    color: var(--vermillion-dark);
    background: hsl(var(--accent));
  }

  @media (max-width: 820px) {
    .cover-hero__grid {
      grid-template-columns: minmax(0, 1fr);
      justify-items: center;
      text-align: center;
    }
    .cover-hero__art {
      width: min(16rem, 60vw);
    }
    .cover-hero__meta {
      text-align: center;
    }
    .article-header__links {
      justify-content: center;
    }
  }
</style>
