---
import BaseLayout from "../layouts/BaseLayout.astro";
import { withBase } from "../lib/url";
---

<BaseLayout
  title="页面未找到"
  description="请求的档案页面不存在。"
  canonicalPath={false}
  pageClass="error-page"
>
  <section class="not-found shell">
    <div class="not-found__inner">
      <p class="not-found__code" aria-hidden="true">404</p>
      <h1>这页档案没有找到</h1>
      <p>它可能已被更名、移动，或尚未收录。可以返回首页，从合集目录重新查找。</p>
      <a class="text-link" href={withBase("/")}>返回档案首页</a>
    </div>
  </section>
</BaseLayout>
